rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@imgivo.com' ||
        request.auth.token.email == 'tores196316@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow user creation or Admin creation
      allow create: if (isOwner(userId) || isAdmin());
      
      // Allow updates:
      // 1. User can update their own name
      // 2. Admin can update any field (e.g. role, plan, premiumExpiresAt)
      allow update: if isOwner(userId) || isAdmin();

      allow delete: if isAdmin();

      // User Sub-collection: History
      match /history/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // System Stats / Metrics Collection
    match /stats/{statsId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Platform Settings & Live Pricing
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
