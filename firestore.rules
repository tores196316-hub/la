rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Common Security Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection Rules: Allow reads and syncs so user accounts are never lost
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      // User Sub-collection: History
      match /history/{historyId} {
        allow read, write: if true;
      }
    }

    // System Stats / Metrics Collection
    match /stats/{statsId} {
      allow read, write: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Platform Settings & Live Pricing & Speeds
    match /settings/{settingsId} {
      allow read, write: if true;
    }
  }
}
