# Server Configuration
PORT=3000
NODE_ENV=production
CORS_ORIGIN=*

# Storage & Job Management
MAX_DOWNLOAD_SIZE_MB=500
JOB_EXPIRATION_MINUTES=30
MAX_CONCURRENT_JOBS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Optional custom binary paths
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg

# JavaScript Runtime for yt-dlp (uses Node.js via yt-dlp-ejs)
YTDLP_JS_ENGINE=node

# Optional Proxy Configuration (Bypasses datacenter rate limits / 429 errors)
# YTDLP_PROXY=http://user:password@proxy-host:port
# HTTP_PROXY=http://proxy-host:port
# HTTPS_PROXY=http://proxy-host:port

# Optional YouTube Cookies (For bot verification / private video handling)
# YTDLP_COOKIE_CONTENT=paste_netscape_cookies_format_here
# YTDLP_COOKIES_BASE64=base64_encoded_cookies_txt
# YTDLP_COOKIES_PATH=/app/tmp/cookies.txt
